{
    "software": "deMonNano",
    "version": "0.1.1",
    "library": "https://github.com/guib-l/DeMonNanoPy",
    "description": "Equivalence between dftb methods and deMonNanoPy input able to run deMonNano code",
    "execution": ["inprocess"],
    "methods":{
        "dftb":{
            "dftb-1":{
                "set": {
                    "DEMON_PARAMETERS.ACTIVE.DFTB": {},
                    "BASIS":{}
                },
                "attributes": {
                    "basis":{
                        "directory":{
                            "target":"BASIS.SKFILE"
                        },
                        "ptype":{
                            "target":"BASIS.PTYPE"
                        }
                    },
                    "charge":{
                        "target":"DEMON_PARAMETERS.ACTIVE.CHARGE"
                    },
                    "filling":{
                        "target":"DEMON_PARAMETERS.ACTIVE.DFTB.FERMI",
                        "unit":"K"
                    },
                    "kpoints":{
                        "target":"DEMON_PARAMETERS.ACTIVE.PBC.KPTS"
                    },
                    "dispersion":{
                        "target":"DEMON_PARAMETERS.ACTIVE.DFTB.DISP",
                        "values":{
                            "model-1":1,
                            "model-2":2
                        }
                    }
                }
            },
            "dftb-2":{
                "set": {
                    "DEMON_PARAMETERS.ACTIVE.DFTB.SCC": true
                },
                "attributes": {
                    "scc-tol":{
                        "target":"DEMON_PARAMETERS.ACTIVE.DFTB.TOL"
                    },
                    "scc-max":{
                        "target":"DEMON_PARAMETERS.ACTIVE.DFTB.MAX"
                    },
                    "mixer":{
                        "target":null,
                        "children": {
                            "mixing-parameter":{
                                "target":"DEMON_PARAMETERS.ACTIVE.DFTB.MIX"
                            }
                        }
                    },
                    "shell-dep":{
                        "target":"DEMON_PARAMETERS.ACTIVE.DFTB.L-DEP"
                    },
                    "level-shift":{
                        "target":"DEMON_PARAMETERS.ACTIVE.DFTB.LEV_S"
                    }
                }
            },
            "ci-dftb":{
                "set": {"DEMON_PARAMETERS.ACTIVE.CI": {}},
                "attributes": {
                    "size-ci":{"target":"DEMON_PARAMETERS.ACTIVE.CI.SIZECI"},
                    "fragments":{"target":"DEMON_PARAMETERS.ACTIVE.CUTSYS.FRAGMENT"}
                }
            },
            "dftb-3":{
                "set":{
                    "DEMON_PARAMETERS.ACTIVE.DFTB.THIRD": true
                },
                "attributes":{
                    "h-correction":{
                        "target":null,
                        "children": {
                            "exponent":{
                                "target":"DEMON_PARAMETERS.ACTIVE.DFTB.GCOR"
                            }
                        }
                    },
                    "hubbard-derivs":{
                        "target":"ORB_PARAMS"
                    }
                }
            }
        },
        "HF":{"supported":false},
        "xTB":{"supported":false}
    },
    "module":{
        "optimization-geometry":{
            "set": {
                "DEMON_MODULE.ACTIVE.OPT": {}
            }
        },
        "td-dftb":{
            "set": {
                "DEMON_PARAMETERS.ACTIVE.TD-DFTB": {}
            },
            "attributes": {
                "excitations":{
                    "target":"DEMON_PARAMETERS.ACTIVE.TD-DFTB.LRESP"
                },
                "symmetry":{
                    "target":"DEMON_PARAMETERS.ACTIVE.TD-DFTB.NO_TRIP",
                    "values":{"singlet":true,"both":null},
                    "strict-values":true
                }
            }
        },
        "frequencies":{
            "set": {
                "DEMON_PARAMETERS.ACTIVE.FREQ": true
            }
        }
    },
    "options":{

    }
}
