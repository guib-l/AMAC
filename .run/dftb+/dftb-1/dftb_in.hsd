ParserOptions {
  ParserVersion = 12
}
Options {
  WriteResultsTag = Yes
}
Analysis {
  CalculateForces = Yes
}
Hamiltonian = DFTB {
  SlaterKosterFiles = Type2FileNames {
    Prefix = "/home/vboxuser/Téléchargements/mio-1-1/"
    Separator = "-"
    Suffix = ".skf"
    LowerCaseTypeName = No
  }
  MaxAngularMomentum {
    O = "p"
    H = "s"
  }
}
Geometry = GenFormat {
  <<< "geo.gen"
}
