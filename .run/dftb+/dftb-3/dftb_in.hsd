ParserOptions {
  ParserVersion = 12
}
Options {
  WriteResultsTag = Yes
}
Analysis {
  CalculateForces = Yes
}
Hamiltonian = DFTB {
  Scc = Yes
  ThirdOrderFull = Yes
  SlaterKosterFiles = Type2FileNames {
    Prefix = "/home/vboxuser/Téléchargements/mio-1-1/"
    Separator = "-"
    Suffix = ".skf"
    LowerCaseTypeName = No
  }
  MaxSccIterations = 999
  Filling = Fermi {
    Temperature [K] = 50
  }
  HCorrection = Damping {
    Exponent = 4.0
  }
  HubbardDerivs {
    H = -0.1857
    O = -0.1575
  }
  MaxAngularMomentum {
    O = "p"
    H = "s"
  }
}
Geometry = GenFormat {
  <<< "geo.gen"
}
