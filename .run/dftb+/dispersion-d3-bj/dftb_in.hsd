ParserOptions {
  ParserVersion = 12
}
Options {
  WriteResultsTag = Yes
}
Analysis {
  CalculateForces = Yes
}
Hamiltonian = DFTB {
  Scc = Yes
  SlaterKosterFiles = Type2FileNames {
    Prefix = "/home/vboxuser/Téléchargements/mio-1-1/"
    Separator = "-"
    Suffix = ".skf"
    LowerCaseTypeName = No
  }
  MaxSccIterations = 999
  SccTolerance = 1e-05
  Dispersion = SimpleDftD3 {
    s6 = 1.0
    s8 = 0.5883
    a1 = 0.5719
    a2 = 3.6017
  }
  MaxAngularMomentum {
    O = "p"
    H = "s"
  }
}
Geometry = GenFormat {
  <<< "geo.gen"
}
